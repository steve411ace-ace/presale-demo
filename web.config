<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- The Web SDK adds the ASP.NET Core handler/process settings during publish. -->
  <system.webServer>
    <security>
      <requestFiltering>
        <!-- 50 MiB video plus multipart overhead; individual limits are enforced by the API. -->
        <requestLimits maxAllowedContentLength="54525952" />
      </requestFiltering>
    </security>
  </system.webServer>
</configuration>
